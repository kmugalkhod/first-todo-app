# Taskspace — environment variables (never commit real values; copy to .env.local)

# Database — Neon serverless PostgreSQL (pooled or direct connection string)
DATABASE_URL=postgresql://USER:PASSWORD@HOST/dbname?sslmode=require

# BetterAuth
BETTER_AUTH_SECRET=generate-a-long-random-secret
BETTER_AUTH_URL=http://localhost:3000
# Comma-separated list of allowed origins (e.g. localhost + preview domains)
TRUSTED_ORIGINS=http://localhost:3000

# Email — Resend (used for the magic-link sign-in email)
RESEND_API_KEY=re_xxxxxxxxxx
# Verified sender; the reserved @resend.dev domain works while you verify your own
FROM_EMAIL=Taskspace <onboarding@resend.dev>

# Optional — Google OAuth (social sign-in). Omit to disable the Google button.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Public flag exposed to the client; "true" shows the Google button.
NEXT_PUBLIC_GOOGLE_ENABLED=false
